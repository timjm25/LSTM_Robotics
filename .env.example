# Copy to .env (git-ignored) or export in your shell. With nothing set, `python -m
# lstm_robotics run` drives the SIMULATED robot. Check settings: python -m lstm_robotics check-robot

# "sim" (default) or "tcp" (real robot through a bridge process; protocol in lstm_robotics/robot.py)
LSTM_ROBOT_DRIVER=sim

# --- tcp driver only ---
# Where your robot-side bridge listens (python -m lstm_robotics.bridge is a dry-run reference)
LSTM_ROBOT_HOST=127.0.0.1
LSTM_ROBOT_PORT=5555
# OpenCV camera: device index (0, 1, ...) or a stream URL / video file path
LSTM_ROBOT_CAMERA=0
LSTM_ROBOT_TIMEOUT_S=2.0

# Safety clip on every step, in the units of your training logs (e.g. metres / radians):
# one value for all six axes, or six values dx,dy,dz,droll,dpitch,dyaw
LSTM_ROBOT_MAX_DELTA=0.01
